    "explorer.confirmDragAndDrop": false,
    "[svinphp]": {},
    "workbench.editor.editorActionsLocation": "hidden",
    "workbench.editor.empty.hint": "hidden",
    "hediet.vscode-drawio.resizeImages": null,
    "[verilog-filelist]": {},
    "[shellscript]": {
        "files.eol": "\n"
    },
    "makefile.configureOnOpen": true,
    "dev.containers.executeInWSL": true,
    "git.mergeEditor": true,
    "C_Cpp.clang_format_fallbackStyle": "{ BasedOnStyle: Google, IndentWidth: 4 }",
    "cmake.showOptionsMovedNotification": false,
    "workbench.colorTheme": "Monokai Pro (Filter Machine)",
    "editor.tabSize": 2,
    "editor.stickyScroll.enabled": false,
    "workbench.tree.enableStickyScroll": false,
    "workbench.editorAssociations": {
        "*.json": "default"
    },
    "material-icon-theme.files.associations": {
        "*.sv.php": "verilog"
    },
    "remote.autoForwardPortsSource": "hybrid",
    "editor.lineNumbers": "relative",
    "chat.commandCenter.enabled": false,
    "extensions.experimental.affinity": {
        "asvetliakov.vscode-neovim": 1
    },
    "vim.smartRelativeLine": true,
    "vim.useSystemClipboard": true,
    "files.associations": {
        "*sv.php": "svinphp",
        "*rdl.php": "systemrdl",
        "*.sv": "systemverilog",
        "*.svh": "systemverilog",
        "*.vh": "systemverilog",
        "*.v": "verilog"
    },
    "verilog.enable": true,
    "verilog.languageServer.veribleVerilogLs.enabled": true,
    "vsicons.dontShowNewVersionMessage": true,
    "editor.minimap.enabled": false,
    "vscode-kanata.localKeysVariant": "deflocalkeys-winiov2",
    "workbench.startupEditor": "none",
    "better-comments.tags": [
        {
            "tag": "!",
            "color": "#FF2D00",
            "strikethrough": false,
            "underline": false,
            "backgroundColor": "transparent",
            "bold": false,
            "italic": false
        },
        {
            "tag": "?",
            "color": "#3498DB",
            "strikethrough": false,
            "underline": false,
            "backgroundColor": "transparent",
            "bold": false,
            "italic": false
        },
        {
            "tag": "//",
            "color": "#474747",
            "strikethrough": false,
            "underline": false,
            "backgroundColor": "transparent",
            "bold": false,
            "italic": false
        },
        {
            "tag": "todo",
            "color": "#FF8C00",
            "strikethrough": false,
            "underline": false,
            "backgroundColor": "transparent",
            "bold": false,
            "italic": false
        },
        {
            "tag": "*",
            "color": "#98C379",
            "strikethrough": false,
            "underline": false,
            "backgroundColor": "transparent",
            "bold": false,
            "italic": false
        }
    ],
    "vscode-neovim.compositeKeys": {},
    "workbench.activityBar.location": "hidden",
    "settingsSync.ignoredSettings": [
        "vscode-neovim.neovimExecutablePaths.linux",
        "vscode-neovim.neovimInitVimPaths.linux",
        "vscode-neovim.useWSL"
    ],
    "git.openRepositoryInParentFolders": "never",
    "window.menuBarVisibility": "compact",
    "workbench.navigationControl.enabled": false,
    "terminal.integrated.enableMultiLinePasteWarning": "never",
    "editor.wordWrap": "off",
    "latex-workshop.latex.autoBuild.cleanAndRetry.enabled": false,
    "latex-workshop.latex.autoBuild.run": "never",
    "cSpell.enabledFileTypes": {
        "asciidoc": true
    },
    "[systemrdl]": {},
    "settingsSync.ignoredExtensions": [
        "gediminaszlatkus.ctags-companion"
    ],
    "ctags-companion.command": "ctags -R --fields=+nKz",
    "ctags-companion.ctagsGoToSymbolInEditorCommand": "ctags --fields=+nKz -f -",
    "ctags-companion.documentSelector": {
        
        "scheme": "file"
    },
    "gitlens.mode.active": "zen",
    "C_Cpp.files.exclude": {
        "**/.vscode": true,
        "**/.vs": true
    },
    "security.workspace.trust.untrustedFiles": "open",
    "github.copilot.enable": {
        "*": false,
        "plaintext": false,
        "markdown": false,
        "scminput": false
    },
    "github.copilot.chat.agent.currentEditorContext.enabled": false,
    "files.insertFinalNewline": true,
    "workbench.browser.showInTitleBar": false,
    "workbench.layoutControl.enabled": false,
    "workbench.experimental.modernUI": false,
    "workbench.enableExperiments": false,
    "chat.titleBar.signIn.enabled": false,
    "chat.titleBar.openInAgentsWindow.enabled": false,
}
