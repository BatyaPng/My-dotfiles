#!/usr/bin/env python3
"""bt-duo: Bluetooth headphones on several adapters, played together.

  bt-duo             TUI: connect, pair on a chosen adapter, move between
                     adapters, choose which headphones join the combined output.
  bt-duo gen-config  write the PipeWire config for bt-duo-combine.service.

The combined output ("Обе пары наушников") runs in its own PipeWire process
(bt-duo-combine.service), so changing who is in it restarts only that process
and leaves the Bluetooth connections alone. Which output is used is still
chosen in KDE; bt-duo never changes the default output.
"""
import curses
import json
import locale
import os
import re
import subprocess
import sys
import threading
import time

STATE_DIR = os.path.join(
    os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"), "bt-duo")
EXCLUDED = os.path.join(STATE_DIR, "excluded")  # one MAC per line, outside git
CONF = os.path.join(STATE_DIR, "combine.conf")
SERVICE = "bt-duo-combine.service"
COMBINED_NAME = "both_headphones"
COMBINED_DESC = "Обе пары наушников"

# A2DP sink, Handsfree, Headset
AUDIO_UUIDS = ("0000110b-", "0000111e-", "00001108-")
USB_VENDORS = {"0bda": "Realtek", "0a5c": "Broadcom", "0a12": "CSR", "8087": "Intel",
               "0cf3": "Qualcomm", "13d3": "IMC", "0489": "Foxconn", "04ca": "Lite-On",
               "2357": "TP-Link", "0b05": "ASUS", "33fa": "UGREEN"}
SPIN = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"


# ---------------------------------------------------------------- helpers

def sh(args, timeout=10):
    """Run a command; return (rc, stdout, short error text)."""
    try:
        p = subprocess.run(args, capture_output=True, text=True, timeout=timeout)
    except subprocess.TimeoutExpired:
        return 124, "", "timed out"
    except FileNotFoundError:
        return 127, "", f"{args[0]} not found"
    err = (p.stderr or p.stdout).strip().splitlines()
    err = err[-1] if err else f"exit {p.returncode}"
    return p.returncode, p.stdout, re.sub(r"^Call failed: ", "", err)


def bz(path, iface, method, *sig_args, timeout=30):
    return sh(["busctl", f"--timeout={timeout}", "call", "org.bluez", path, iface, method,
               *sig_args], timeout=timeout + 5)


def read_excluded():
    try:
        with open(EXCLUDED) as f:
            return {l.strip().upper() for l in f if re.fullmatch(r"\s*([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}\s*", l)}
    except OSError:
        return set()


def write_excluded(macs):
    os.makedirs(STATE_DIR, exist_ok=True)
    with open(EXCLUDED, "w") as f:
        f.writelines(m + "\n" for m in sorted(macs))


def gen_config():
    """Write the combine-stream config: every Bluetooth output except excluded ones.

    Two node.name conditions in one match object are ANDed; no backslashes,
    PipeWire's config parser rejects them in these regexes."""
    match = 'media.class = "Audio/Sink" node.name = "~bluez_output.*"'
    ex = sorted(read_excluded())
    if ex:
        match += ' node.name = "!~bluez_output.(%s).*"' % "|".join(m.replace(":", "_") for m in ex)
    conf = f"""# Generated by bt-duo from {EXCLUDED}. Change it with bt-duo, not by hand.
context.properties = {{ log.level = 2 }}
context.spa-libs = {{
  audio.convert.* = audioconvert/libspa-audioconvert
  support.*       = support/libspa-support
}}
context.modules = [
  {{ name = libpipewire-module-rt flags = [ ifexists nofail ] }}
  {{ name = libpipewire-module-protocol-native }}
  {{ name = libpipewire-module-client-node }}
  {{ name = libpipewire-module-adapter }}
  {{ name = libpipewire-module-combine-stream
    args = {{
      combine.mode = sink
      node.name = "{COMBINED_NAME}"
      node.description = "{COMBINED_DESC}"
      combine.latency-compensate = true
      combine.props = {{
        audio.position = [ FL FR ]
        node.virtual = false
      }}
      stream.props = {{ }}
      stream.rules = [
        {{ matches = [ {{ {match} }} ]
          actions = {{ create-stream = {{ }} }}
        }}
      ]
    }}
  }}
]
"""
    os.makedirs(STATE_DIR, exist_ok=True)
    tmp = CONF + ".tmp"
    with open(tmp, "w") as f:
        f.write(conf)
    os.replace(tmp, CONF)


def adapter_label(hci):
    base = f"/sys/class/bluetooth/{hci}/device/.."
    def rd(name):
        try:
            with open(os.path.join(base, name)) as f:
                return f.read().strip()
        except OSError:
            return ""
    vendor = USB_VENDORS.get(rd("idVendor")) or rd("manufacturer").split(" ")[0] or "Bluetooth"
    kind = "USB" if rd("removable") == "removable" else "built-in"
    return f"{vendor} ({kind})"


def is_audio(d):
    if any(u.startswith(AUDIO_UUIDS) for u in d.get("UUIDs") or []):
        return True
    if str(d.get("Icon", "")).startswith("audio-"):
        return True
    return (d.get("Class", 0) >> 8) & 0x1F == 4  # major class Audio/Video


# ---------------------------------------------------------------- state

class Snapshot:
    def __init__(self):
        self.error = None
        self.adapters = []   # dicts: hci, path, Address, Powered, label
        self.devices = []    # audio devices: Address, Alias, Paired, Connected, path, hci, battery, RSSI
        self.sinks = {}      # MAC -> {id, state, vol}
        self.default = "?"
        self.service = False
        try:
            self._bluez()
        except Exception as e:  # noqa: BLE001 - shown to the user
            self.error = str(e)
        self._pipewire()
        self.service = sh(["systemctl", "--user", "is-active", "--quiet", SERVICE])[0] == 0

    def _bluez(self):
        rc, out, err = sh(["busctl", "--json=short", "call", "org.bluez", "/",
                           "org.freedesktop.DBus.ObjectManager", "GetManagedObjects"])
        if rc:
            raise RuntimeError(f"BlueZ: {err}")
        for path, ifs in sorted(json.loads(out)["data"][0].items()):
            def props(i):
                return {k: v["data"] for k, v in ifs.get(i, {}).items()}
            if "org.bluez.Adapter1" in ifs:
                a = props("org.bluez.Adapter1")
                a.update(path=path, hci=path.rsplit("/", 1)[1])
                a["label"] = adapter_label(a["hci"])
                self.adapters.append(a)
            elif "org.bluez.Device1" in ifs:
                d = props("org.bluez.Device1")
                if not is_audio(d):
                    continue
                d.update(path=path, hci=d.get("Adapter", "").rsplit("/", 1)[-1],
                         battery=props("org.bluez.Battery1").get("Percentage"))
                self.devices.append(d)
        self.adapters.sort(key=lambda a: int(re.sub(r"\D", "", a["hci"]) or 0))

    def _pipewire(self):
        rc, out, _ = sh(["pw-dump"])
        names = {}
        try:
            objs = json.loads(out) if rc == 0 else []
        except ValueError:
            objs = []
        for o in objs:
            if o.get("type") != "PipeWire:Interface:Node":
                continue
            info = o.get("info") or {}
            p = info.get("props") or {}
            name = p.get("node.name", "")
            names[name] = p.get("node.description") or name
            m = re.match(r"bluez_output\.([0-9A-F]{2}(?:_[0-9A-F]{2}){5})\.", name)
            if m and p.get("media.class") == "Audio/Sink":
                self.sinks[m.group(1).replace("_", ":")] = {"id": o["id"], "state": info.get("state")}
        for s in self.sinks.values():
            rc, out, _ = sh(["wpctl", "get-volume", str(s["id"])])
            m = re.search(r"Volume:\s*([\d.]+)", out)
            s["vol"] = float(m.group(1)) if m else None
            s["muted"] = "MUTED" in out
        default = sh(["pactl", "get-default-sink"])[1].strip()
        self.default = names.get(default, default or "?")

    def adapter(self, hci):
        return next((a for a in self.adapters if a["hci"] == hci), None)

    def paired_on(self, mac):
        return [d["hci"] for d in self.devices if d["Address"] == mac and d.get("Paired")]

    def audio_count(self, hci):
        return sum(1 for d in self.devices if d["hci"] == hci and d.get("Paired"))

    def least_loaded(self, hcis):
        return min(hcis, key=lambda h: (self.audio_count(h), h), default=None)


class Scanner:
    """Discovery on one adapter. BlueZ stops discovery when the client that
    started it goes away, so a bluetoothctl process is kept alive for it."""

    def __init__(self, adapter_mac):
        self.p = subprocess.Popen(["bluetoothctl"], stdin=subprocess.PIPE,
                                  stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, text=True)
        self._send(f"select {adapter_mac}\nscan bredr\n")

    def _send(self, s):
        try:
            self.p.stdin.write(s)
            self.p.stdin.flush()
        except (OSError, ValueError):
            pass

    def stop(self):
        if self.p.poll() is None:
            self._send("scan off\nquit\n")
            try:
                self.p.wait(3)
            except subprocess.TimeoutExpired:
                self.p.kill()


# ---------------------------------------------------------------- dialogs

class Dialog:
    title = ""
    width = 44

    def lines(self, app):
        """List of (text, attr) to draw inside the box."""
        return []

    def key(self, app, k):
        """Handle a key; return False to close."""
        return k not in (27, ord("q"))


class Picker(Dialog):
    """Choose an adapter (screens 2 and 5, and 'keep on which adapter')."""

    def __init__(self, title, hcis, top, note, on_pick, star=True):
        self.title, self.hcis, self.top, self.note, self.on_pick = title, hcis, top, note, on_pick
        self.star = star
        self.sel = 0

    def lines(self, app):
        s = app.snap
        best = s.least_loaded(self.hcis) if self.star and len(self.hcis) > 1 else None
        out = [(t, 0) for t in self.top] + [("", 0)]
        for i, h in enumerate(self.hcis):
            a = s.adapter(h)
            mark = "  ★" if h == best else ""
            text = f"{'>' if i == self.sel else ' '} {h:<5} {a['label'] if a else '':<19} {s.audio_count(h)} audio{mark}"
            out.append((text, curses.A_REVERSE if i == self.sel else 0))
        out.append(("", 0))
        if best:
            out.append(("★ = least loaded (recommended)", curses.A_DIM))
        out += [(t, 0) for t in self.note]
        out.append(("Enter select   Esc cancel", curses.A_DIM))
        return out

    def key(self, app, k):
        if k in (curses.KEY_UP, ord("k")):
            self.sel = max(0, self.sel - 1)
        elif k in (curses.KEY_DOWN, ord("j")):
            self.sel = min(len(self.hcis) - 1, self.sel + 1)
        elif k in (10, 13, curses.KEY_ENTER):
            app.dialog = None
            self.on_pick(self.hcis[self.sel])
            return app.dialog is not None
        return super().key(app, k)


class Confirm(Dialog):
    def __init__(self, title, text, on_yes, hint="y yes   n no", yes_keys=(ord("y"),)):
        self.title, self.text, self.on_yes, self.hint, self.yes_keys = title, text, on_yes, hint, yes_keys

    def lines(self, app):
        return [(t, 0) for t in self.text] + [("", 0), (self.hint, curses.A_DIM)]

    def key(self, app, k):
        if k in self.yes_keys:
            app.dialog = None
            self.on_yes()
            return app.dialog is not None
        return k not in (27, ord("n"), ord("q"))


class Scan(Dialog):
    """Screen 3. With target set (move), pairs that MAC as soon as it shows up."""
    width = 46

    def __init__(self, app, hci, target=None):
        self.hci, self.target = hci, target
        a = app.snap.adapter(hci)
        self.title = f"Pair on {hci} · scanning…"
        self.scanner = Scanner(a["Address"])
        self.sel = 0
        self.started = time.time()

    def found(self, app):
        devs = [d for d in app.snap.devices if d["hci"] == self.hci and not d.get("Paired")
                and d.get("RSSI") is not None]
        if self.target:
            devs = [d for d in devs if d["Address"] == self.target]
        return sorted(devs, key=lambda d: -d["RSSI"])

    def lines(self, app):
        devs = self.found(app)
        self.sel = min(self.sel, max(0, len(devs) - 1))
        if self.target and devs:
            self.pair(app, devs[0])
            return []
        out = [("Put headphones in pairing mode.", 0), ("", 0)]
        for i, d in enumerate(devs):
            name = d.get("Alias") or d["Address"]
            out.append((f"{'>' if i == self.sel else ' '} {name[:28]:<28} {d['RSSI']:>4} dBm",
                        curses.A_REVERSE if i == self.sel else 0))
        spin = SPIN[int(time.time() * 8) % len(SPIN)]
        out.append((f"  {spin} searching" + (f" for {self.target}" if self.target else ""), curses.A_DIM))
        out += [("", 0), ("Enter pair   Esc cancel", curses.A_DIM)]
        return out

    def pair(self, app, d):
        app.dialog = Progress(app, d, self.scanner)

    def key(self, app, k):
        devs = self.found(app)
        if k in (curses.KEY_UP, ord("k")):
            self.sel = max(0, self.sel - 1)
        elif k in (curses.KEY_DOWN, ord("j")):
            self.sel = min(max(0, len(devs) - 1), self.sel + 1)
        elif k in (10, 13, curses.KEY_ENTER) and devs:
            self.pair(app, devs[self.sel])
            return True
        elif k in (27, ord("q")):
            self.scanner.stop()
            return False
        return True


class Progress(Dialog):
    """Screen 4: pair → trust → connect, with retry."""
    width = 46
    STEPS = ("paired", "trusted", "connected")

    def __init__(self, app, dev, scanner):
        self.dev, self.scanner = dev, scanner
        self.title = f"Pair {dev.get('Alias') or dev['Address']} on {dev['hci']}"
        self.start(app)

    def start(self, app):
        self.state = ["", "", ""]   # "" pending, "run", "ok", or error text
        self.done = False
        threading.Thread(target=self.run, args=(app,), daemon=True).start()

    def run(self, app):
        path = self.dev["path"]
        try:
            self.state[0] = "run"
            rc, _, err = bz(path, "org.bluez.Device1", "Pair", timeout=60)
            if rc and "AlreadyExists" not in err and "Already Exists" not in err:
                self.state[0] = err or "failed"
                return
            self.state[0] = "ok"
            if self.scanner:
                self.scanner.stop()  # discovery hurts audio, stop before connecting
            self.state[1] = "run"
            rc, _, err = sh(["busctl", "set-property", "org.bluez", path, "org.bluez.Device1",
                             "Trusted", "b", "true"])
            self.state[1] = "ok" if rc == 0 else err
            self.state[2] = "run"
            for attempt in range(3):
                rc, _, err = bz(path, "org.bluez.Device1", "Connect", timeout=30)
                if rc == 0:
                    break
                time.sleep(2)
            self.state[2] = "ok" if rc == 0 else err
        finally:
            self.done = True
            app.refresh_now()

    def lines(self, app):
        out = []
        spin = SPIN[int(time.time() * 8) % len(SPIN)]
        for name, st in zip(self.STEPS, self.state):
            verb = {"paired": "pairing", "trusted": "trusting", "connected": "connecting"}[name]
            if st == "ok":
                out.append((f"✓ {name}", app.c_ok))
            elif st == "run":
                out.append((f"{spin} {verb}…", 0))
            elif st:
                out.append((f"✗ {verb} failed: {st}", app.c_err))
                if name == "paired":
                    out.append(("  Is the device in pairing mode?", 0))
                break
        failed = any(s not in ("", "run", "ok") for s in self.state)
        if self.done:
            out += [("", 0), ("r retry   Esc back" if failed else "Enter / Esc close", curses.A_DIM)]
        return out

    def key(self, app, k):
        if not self.done:
            return True
        if k == ord("r") and any(s not in ("", "ok") for s in self.state):
            self.start(app)
            return True
        if k in (27, 10, 13, curses.KEY_ENTER, ord("q")):
            if self.scanner:
                self.scanner.stop()
            return False
        return True


class Help(Dialog):
    title = "Help"
    width = 54

    def lines(self, app):
        return [(t, 0) for t in (
            "c / d    connect / disconnect selected",
            "space    include / exclude from \"Both\" output",
            "+ / -    volume of selected device",
            "p        pair new device on chosen adapter",
            "m        move device to another adapter",
            "x        forget (unpair) device",
            "f        fix device paired on several adapters",
            "r        refresh       q quit",
            "",
            "Choose the sound output (Both / one pair) in KDE.",
        )] + [("", 0), ("any key closes", curses.A_DIM)]

    def key(self, app, k):
        return False


# ---------------------------------------------------------------- app

class App:
    def __init__(self, scr):
        self.scr = scr
        self.snap = Snapshot()
        self.excluded = read_excluded()
        self.dialog = None
        self.sel = None          # (hci, mac) of selected device
        self.msg, self.msg_err, self.msg_until = "", False, 0
        self.job, self.job_label, self.busy_mac = None, "", None
        self.last = time.time()
        self.lock = threading.Lock()
        curses.curs_set(0)
        curses.use_default_colors()
        for i, c in enumerate((curses.COLOR_GREEN, curses.COLOR_RED, curses.COLOR_YELLOW,
                               curses.COLOR_CYAN), 1):
            curses.init_pair(i, c, -1)
        self.c_ok, self.c_err = curses.color_pair(1), curses.color_pair(2)
        self.c_warn, self.c_head = curses.color_pair(3), curses.color_pair(4) | curses.A_BOLD
        scr.timeout(150)

    # -------- data

    def refresh_now(self):
        self.last = 0

    def tick(self):
        if time.time() - self.last >= 2:
            snap = Snapshot()
            with self.lock:
                self.snap = snap
                self.excluded = read_excluded()
            self.last = time.time()

    def rows(self):
        """[(adapter, device-or-None)] in display order."""
        out = []
        for a in self.snap.adapters:
            out.append((a, None))
            devs = [d for d in self.snap.devices if d["hci"] == a["hci"] and d.get("Paired")]
            out += [(a, d) for d in sorted(devs, key=lambda d: d.get("Alias", ""))]
        return out

    def selected(self):
        devs = [d for _, d in self.rows() if d]
        if not devs:
            return None
        for d in devs:
            if (d["hci"], d["Address"]) == self.sel:
                return d
        self.sel = (devs[0]["hci"], devs[0]["Address"])
        return devs[0]

    def move_sel(self, step):
        devs = [d for _, d in self.rows() if d]
        cur = self.selected()
        if cur:
            i = devs.index(cur)
            d = devs[max(0, min(len(devs) - 1, i + step))]
            self.sel = (d["hci"], d["Address"])

    def flash(self, text, err=False):
        self.msg, self.msg_err, self.msg_until = text, err, time.time() + 6

    def run_job(self, label, mac, fn):
        if self.job and self.job.is_alive():
            self.flash(f"busy: {self.job_label}", err=True)
            return
        self.job_label, self.busy_mac = label, mac

        def wrap():
            try:
                res = fn()
                if res:
                    self.flash(*res) if isinstance(res, tuple) else self.flash(res)
            except Exception as e:  # noqa: BLE001
                self.flash(f"✗ {e}", err=True)
            finally:
                self.busy_mac = None
                self.refresh_now()
        self.job = threading.Thread(target=wrap, daemon=True)
        self.job.start()

    def warnings(self):
        s, out = self.snap, []
        if s.error:
            return [s.error]
        if not s.adapters:
            return ["No Bluetooth adapter found"]
        for a in s.adapters:
            if not a.get("Powered"):
                out.append(f"{a['hci']} is powered off (turn it on in KDE Bluetooth settings)")
            playing = [d for d in s.devices if d["hci"] == a["hci"]
                       and s.sinks.get(d["Address"], {}).get("state") == "running"]
            if len(playing) > 1:
                out.append(f"{a['hci']}: {len(playing)} headphones playing on one adapter — may stutter")
        seen = set()
        for d in s.devices:
            on = s.paired_on(d["Address"])
            if len(on) > 1 and d["Address"] not in seen:
                seen.add(d["Address"])
                out.append(f"{d.get('Alias')} is paired on {' and '.join(on)} — may connect to the "
                           f"wrong one. Press f to fix")
        if len(s.adapters) == 1:
            out.append("Only 1 adapter found — plug in a USB dongle to use more")
        if not s.service:
            out.append(f"Combined output is off: systemctl --user enable --now {SERVICE.removesuffix('.service')}")
        return out

    # -------- actions

    def act_connect(self, d, on):
        name = d.get("Alias") or d["Address"]
        method = "Connect" if on else "Disconnect"

        def job():
            rc, _, err = bz(d["path"], "org.bluez.Device1", method, timeout=30)
            if rc:
                return (f"✗ {method.lower()} {name}: {err}", True)
            return f"{name} {'connected' if on else 'disconnected'} ✓"
        self.run_job(f"{method.lower()}ing {name}", d["Address"], job)

    def act_toggle(self, d):
        mac, name = d["Address"], d.get("Alias") or d["Address"]
        ex = set(self.excluded)
        now_out = mac not in ex
        ex.symmetric_difference_update({mac})

        def job():
            write_excluded(ex)
            self.excluded = ex
            gen_config()
            what = f"{name} {'excluded from' if now_out else 'included in'} \"Both\""
            if not self.snap.service:
                return (f"{what} (saved; combined output service is not running)", True)
            rc, _, err = sh(["systemctl", "--user", "restart", SERVICE], timeout=20)
            return (f"✗ restart {SERVICE}: {err}", True) if rc else f"{what} ✓"
        self.run_job(f"updating \"Both\"", mac, job)

    def act_volume(self, d, step):
        s = self.snap.sinks.get(d["Address"])
        if not s:
            self.flash("not connected", err=True)
            return
        sh(["wpctl", "set-volume", "-l", "1.0", str(s["id"]), f"5%{step}"])
        rc, out, _ = sh(["wpctl", "get-volume", str(s["id"])])
        m = re.search(r"Volume:\s*([\d.]+)", out)
        if m:
            s["vol"] = float(m.group(1))

    def act_pair(self):
        hcis = [a["hci"] for a in self.snap.adapters if a.get("Powered")]
        if not hcis:
            self.flash("no powered adapter", err=True)
            return
        hcis.sort(key=lambda h: (self.snap.audio_count(h), h))
        self.dialog = Picker("Pair new device", hcis, ["Which adapter?"], [],
                             lambda h: setattr(self, "dialog", Scan(self, h)))

    def act_move(self, d):
        name = d.get("Alias") or d["Address"]
        others = [a["hci"] for a in self.snap.adapters if a.get("Powered") and a["hci"] != d["hci"]]
        if not others:
            self.flash("no other adapter to move to", err=True)
            return
        others.sort(key=lambda h: (self.snap.audio_count(h), h))
        src = self.snap.adapter(d["hci"])

        def picked(h):
            def go():
                bz(src["path"], "org.bluez.Adapter1", "RemoveDevice", "o", d["path"])
                self.refresh_now()
                self.tick()
                self.dialog = Scan(self, h, target=d["Address"])
            self.dialog = Confirm(f"Move {name} to {h}",
                                  [f"It will be unpaired from {d['hci']}.",
                                   "Put headphones in pairing mode, then", "press Enter."],
                                  go, hint="Enter continue   Esc cancel", yes_keys=(10, 13, curses.KEY_ENTER))
        self.dialog = Picker(f"Move {name}", others,
                             [f"Now on: {d['hci']} {src['label'] if src else ''}", "Move to:"], [], picked)

    def act_forget(self, d):
        name = d.get("Alias") or d["Address"]
        a = self.snap.adapter(d["hci"])

        def yes():
            def job():
                rc, _, err = bz(a["path"], "org.bluez.Adapter1", "RemoveDevice", "o", d["path"])
                return (f"✗ forget {name}: {err}", True) if rc else f"{name} forgotten on {d['hci']} ✓"
            self.run_job(f"forgetting {name}", d["Address"], job)
        self.dialog = Confirm(f"Forget {name}?",
                              [f"Unpairs it from {d['hci']}. You will need", "to pair it again to use it."], yes)

    def act_fix(self, d):
        mac, name = d["Address"], d.get("Alias") or d["Address"]
        on = self.snap.paired_on(mac)
        if len(on) < 2:
            self.flash(f"{name} is paired on one adapter only")
            return
        devs = [x for x in self.snap.devices if x["Address"] == mac and x.get("Paired")]
        connected = [x["hci"] for x in devs if x.get("Connected")]

        def keep(h):
            def job():
                for x in devs:
                    if x["hci"] != h:
                        a = self.snap.adapter(x["hci"])
                        rc, _, err = bz(a["path"], "org.bluez.Adapter1", "RemoveDevice", "o", x["path"])
                        if rc:
                            return (f"✗ unpair from {x['hci']}: {err}", True)
                return f"{name} kept on {h} only ✓"
            self.run_job(f"fixing {name}", mac, job)
        if len(connected) == 1:
            keep(connected[0])
        else:
            self.dialog = Picker(f"Fix {name}", on, ["Keep it on which adapter?"],
                                 ["Others will be unpaired."], keep, star=False)

    def key(self, k):
        if self.dialog:
            if not self.dialog.key(self, k):
                self.dialog = None
            return True
        d = self.selected()
        if k in (ord("q"), 27):
            return False
        if k in (curses.KEY_UP, ord("k")):
            self.move_sel(-1)
        elif k in (curses.KEY_DOWN, ord("j"), 9):
            self.move_sel(1)
        elif k == ord("r"):
            self.refresh_now()
        elif k == ord("?"):
            self.dialog = Help()
        elif k == ord("p"):
            self.act_pair()
        elif d is None:
            pass
        elif k == ord("c"):
            self.act_connect(d, True)
        elif k == ord("d"):
            self.act_connect(d, False)
        elif k == ord(" "):
            self.act_toggle(d)
        elif k in (ord("+"), ord("=")):
            self.act_volume(d, "+")
        elif k in (ord("-"), ord("_")):
            self.act_volume(d, "-")
        elif k == ord("m"):
            self.act_move(d)
        elif k == ord("x"):
            self.act_forget(d)
        elif k == ord("f"):
            self.act_fix(d)
        return True

    # -------- drawing

    def put(self, y, x, text, attr=0):
        h, w = self.scr.getmaxyx()
        if 0 <= y < h and x < w:
            try:
                self.scr.addnstr(y, x, text, w - x - 1, attr)
            except curses.error:
                pass

    def draw(self):
        s = self.scr
        s.erase()
        h, w = s.getmaxyx()
        snap = self.snap
        self.put(0, 1, "bt-duo · Bluetooth audio", self.c_head)
        self.put(1, 1, "Output in KDE: ")
        self.put(1, 16, snap.default, curses.A_BOLD)
        y = 3
        sel = self.selected()
        spin = SPIN[int(time.time() * 8) % len(SPIN)]
        for a, d in self.rows():
            if y >= h - 6:
                break
            if d is None:
                n = snap.audio_count(a["hci"])
                cnt = "no devices" if n == 0 else f"{n} audio device{'s' if n > 1 else ''}"
                off = "" if a.get("Powered") else "  (off)"
                self.put(y, 1, f"▾ {a['hci']:<5} {a['label']}{off}", curses.A_BOLD)
                self.put(y, max(40, w - 18), cnt, curses.A_DIM)
            else:
                mac = d["Address"]
                sink = snap.sinks.get(mac)
                box = "[ ]" if mac in self.excluded else "[x]"
                if self.busy_mac == mac:
                    state, sattr = f"{spin} {self.job_label.split(' ')[0]}", self.c_warn
                elif sink and sink.get("state") == "running":
                    state, sattr = "● playing", self.c_ok
                elif d.get("Connected"):
                    state, sattr = "○ connected", 0
                else:
                    state, sattr = "– off", curses.A_DIM
                batt = f"{d['battery']}%" if d.get("battery") is not None and d.get("Connected") else ""
                dup = "  ⚠" if len(snap.paired_on(mac)) > 1 else ""
                name = (d.get("Alias") or mac)[:18]
                is_sel = sel is d
                attr = curses.A_REVERSE if is_sel else 0
                line = f"{'>' if is_sel else ' '} {box} {name:<18}"
                self.put(y, 2, line, attr)
                self.put(y, 2 + len(line) + 1, f"{state:<13}", sattr | attr)
                self.put(y, 2 + len(line) + 15, f"{batt:>4}{dup}", attr)
                if sink and sink.get("vol") is not None and w >= 70:
                    v = min(1.0, sink["vol"])
                    bar = "█" * round(v * 10) + "░" * (10 - round(v * 10))
                    self.put(y, 2 + len(line) + 23, f"vol {bar}{' muted' if sink.get('muted') else ''}",
                             curses.A_DIM if sink.get("muted") else 0)
            y += 1
        if not snap.devices and snap.adapters:
            self.put(y + 1, 3, "No audio devices paired yet — press p to pair", curses.A_DIM)

        # bottom: warnings, message, key hints
        foot = []
        for wtext in self.warnings():
            foot.append(("⚠ " + wtext, self.c_warn))
        if self.msg and time.time() < self.msg_until:
            foot.append((self.msg, self.c_err if self.msg_err else self.c_ok))
        hints = ["↑↓ select  c connect  d disconnect  space in/out of \"Both\"",
                 "+/- volume  p pair new  m move  x forget  r refresh  ? help  q quit"]
        by = h - len(hints) - len(foot) - 1
        self.put(by, 0, "─" * (w - 1), curses.A_DIM)
        for i, (t, a) in enumerate(foot):
            self.put(by + 1 + i, 1, t, a)
        for i, t in enumerate(hints):
            self.put(h - len(hints) + i, 1, t, curses.A_DIM)

        if self.dialog:
            self.draw_dialog(self.dialog)
        s.refresh()

    def draw_dialog(self, dlg):
        lines = dlg.lines(self)
        if self.dialog is not dlg:  # dialog replaced itself while drawing (scan → progress)
            if self.dialog:
                self.draw_dialog(self.dialog)
            return
        h, w = self.scr.getmaxyx()
        bw = min(w - 2, max(dlg.width, len(dlg.title) + 6, *(len(t) + 4 for t, _ in lines)))
        bh = len(lines) + 2
        y0, x0 = max(0, (h - bh) // 2), max(0, (w - bw) // 2)
        for i in range(bh):
            if i == 0:
                row = "┌ " + dlg.title + " " + "─" * max(0, bw - len(dlg.title) - 4) + "┐"
            elif i == bh - 1:
                row = "└" + "─" * (bw - 2) + "┘"
            else:
                row = "│" + " " * (bw - 2) + "│"
            self.put(y0 + i, x0, row, curses.A_BOLD if i == 0 else 0)
        for i, (t, a) in enumerate(lines):
            self.put(y0 + 1 + i, x0 + 2, t[:bw - 4], a)

    def loop(self):
        while True:
            self.tick()
            self.draw()
            k = self.scr.getch()
            if k == curses.KEY_RESIZE or k == -1:
                continue
            if not self.key(k):
                break
        scanner = getattr(self.dialog, "scanner", None)
        if scanner:
            scanner.stop()


def main():
    if sys.argv[1:] == ["gen-config"]:
        gen_config()
        return
    if sys.argv[1:]:
        print(__doc__.strip())
        sys.exit(0 if sys.argv[1] in ("-h", "--help") else 2)
    locale.setlocale(locale.LC_ALL, "")
    os.environ.setdefault("ESCDELAY", "25")
    curses.wrapper(lambda scr: App(scr).loop())


if __name__ == "__main__":
    main()
